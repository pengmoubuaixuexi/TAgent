<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.ai.infrastructure.dao.IAiEventLogDao">

    <resultMap id="AiEventLogMap" type="cn.bugstack.ai.infrastructure.dao.po.AiEventLog">
        <id     column="id"                property="id"/>
        <result column="session_id"        property="sessionId"/>
        <result column="run_id"            property="runId"/>
        <result column="user_id"           property="userId"/>
        <result column="tenant_id"         property="tenantId"/>
        <result column="agent_id"          property="agentId"/>
        <result column="billing_scope"     property="billingScope"/>
        <result column="step_name"         property="stepName"/>
        <result column="step_index"        property="stepIndex"/>
        <result column="input_prompt"      property="inputPrompt"/>
        <result column="output_text"       property="outputText"/>
        <result column="model"             property="model"/>
        <result column="prompt_tokens"     property="promptTokens"/>
        <result column="completion_tokens" property="completionTokens"/>
        <result column="latency_ms"        property="latencyMs"/>
        <result column="created_at"        property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="cn.bugstack.ai.infrastructure.dao.po.AiEventLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_event_log
            (session_id, run_id, user_id, tenant_id, agent_id, billing_scope, step_name, step_index, input_prompt, output_text, model, prompt_tokens, completion_tokens, latency_ms, created_at)
        VALUES
            (#{sessionId}, #{runId}, #{userId}, #{tenantId}, #{agentId}, #{billingScope}, #{stepName}, #{stepIndex}, #{inputPrompt}, #{outputText}, #{model}, #{promptTokens}, #{completionTokens}, #{latencyMs}, NOW())
    </insert>

</mapper>
